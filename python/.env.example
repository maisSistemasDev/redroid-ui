# Copie para .env ou exporte antes de rodar a API / Electron
HERO_SMS_API_KEY=
# Opcional (padrão: https://hero-sms.com/stubs/handler_api.php)
# HERO_SMS_API_URL=https://hero-sms.com/stubs/handler_api.php

REDROID_USE_SUDO_DOCKER=1
REDROID_API_PORT=8765

# Câmera V4L2 (opcional): URL direta para camera.v4l2.so (x86_64, Android 12)
# REDROID_CAMERA_HAL_URL=
# Dispositivo loopback no host (após setup-host.sh)
# REDROID_CAMERA_LOOPBACK=/dev/video10

# Deep-Live-Cam (modo câmera deeplive): clone com venv + modelos em models/
# REDROID_DEEPLIVE_ROOT=/home/you/Deep-Live-Cam
# REDROID_DEEPLIVE_PROVIDER=cuda
